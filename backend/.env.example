# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=change-me-32-char-min # used for JWT signing — generate with: openssl rand -hex 32
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass@localhost:5432/hrms_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis (Celery broker + result backend) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 hours

# ── Object Storage (S3-compatible) ───────────────────────────────────────────
STORAGE_PROVIDER=minio               # s3 | minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1
S3_BUCKET_NAME=road-express-resumes
MINIO_ENDPOINT_URL=http://localhost:9000  # only needed if STORAGE_PROVIDER=minio

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password
EMAIL_FROM_ADDRESS=hr@roadexpress.com
EMAIL_FROM_NAME=Road Express HR Team

# ── AI Screening ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# ── Google Calendar (for interview scheduling) ────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary           # or specific calendar ID

# ── Candidate Portal URL (used in email links) ────────────────────────────────
CANDIDATE_PORTAL_URL=http://localhost:3000

# ── Application Settings ──────────────────────────────────────────────────────
MAX_RESUME_SIZE_MB=5
ALLOWED_RESUME_TYPES=application/pdf
