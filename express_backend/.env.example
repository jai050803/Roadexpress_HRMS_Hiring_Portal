# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadexpress_hrms
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=roadexpress_hrms

# JWT Authentication
JWT_SECRET=roadexpress_hiring_portal_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS & File Uploads
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Google Gemini AI (Automated Resume Screening)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# SMTP Email Configuration (Candidate Notifications & Interview Invites)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password_here
EMAIL_FROM_ADDRESS=hr@roadexpress.com
EMAIL_FROM_NAME=Road Express HR Team
